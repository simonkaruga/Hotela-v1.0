// Master database schema — shared by @hotela/api (NestJS) via @prisma/client.
// Phase 0/1 scope only: core PMS tables needed to run reservations, front desk,
// and folios. Every other module folder in this repo is a structural placeholder
// until its phase (see /docs/architecture.md and the masterplan Section 15).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  timezone     String   @default("Africa/Nairobi")
  currency     String   @default("KES")
  tagline      String?
  heroImageUrl String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  roomTypes    RoomType[]
  rooms        Room[]
  guests       Guest[]
  reservations Reservation[]
  users        User[]
  menuItems    MenuItem[]
  treatments   Treatment[]
  accounts     Account[]
  suppliers         Supplier[]
  inventoryItems    InventoryItem[]
  purchaseOrders    PurchaseOrder[]
  corporateAccounts CorporateAccount[]
  employees         Employee[]
  eventInquiries    EventInquiry[]
  maintenanceTickets MaintenanceTicket[]
  notifications      Notification[]
}

model User {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
}

enum UserRole {
  FRONT_DESK
  NIGHT_AUDIT
  HOUSEKEEPING_SUPERVISOR
  GENERAL_MANAGER
}

model RoomType {
  id         String  @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  baseRate   Decimal @db.Decimal(10, 2)
  maxOccupancy Int

  rooms Room[]
  ratePlans RatePlan[]
}

model Room {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  number     String
  floor      String?
  status     RoomStatus @default(CLEAN)

  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([propertyId, number])
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

model Guest {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  firstName  String
  lastName   String
  email      String?
  phone      String?
  idNumber   String?
  vip        Boolean  @default(false)
  loyaltyPoints Int         @default(0)
  loyaltyTier   LoyaltyTier @default(BRONZE)
  createdAt  DateTime @default(now())

  reservations        Reservation[]
  loyaltyTransactions LoyaltyTransaction[]
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  guestId     String
  guest       Guest                  @relation(fields: [guestId], references: [id])
  type        LoyaltyTransactionType
  points      Int
  description String
  createdAt   DateTime               @default(now())
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

model Reservation {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id])
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id])
  checkIn    DateTime
  checkOut   DateTime
  status     ReservationStatus @default(CONFIRMED)
  createdAt  DateTime @default(now())

  folio        Folio?
  orders       Order[]
  appointments Appointment[]
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Folio {
  id            String   @id @default(uuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  status        FolioStatus @default(OPEN)
  createdAt     DateTime @default(now())

  transactions FolioTransaction[]
}

enum FolioStatus {
  OPEN
  SETTLED
  VOID
}

model FolioTransaction {
  id        String   @id @default(uuid())
  folioId   String
  folio     Folio    @relation(fields: [folioId], references: [id])
  type      TransactionType
  amount    Decimal  @db.Decimal(10, 2)
  description String
  createdAt DateTime @default(now())

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
}

enum TransactionType {
  ROOM_CHARGE
  FNB_CHARGE
  SPA_CHARGE
  PAYMENT
  REFUND
  ADJUSTMENT
  TAX
}

model MenuItem {
  id         String  @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  price      Decimal @db.Decimal(10, 2)
  category   String?
  available  Boolean @default(true)

  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  status        OrderStatus @default(OPEN)
  createdAt     DateTime    @default(now())

  items OrderItem[]
}

enum OrderStatus {
  OPEN
  POSTED
  VOID
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
}

model Treatment {
  id              String  @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  name            String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int
  available       Boolean @default(true)

  appointments Appointment[]
}

model Appointment {
  id            String            @id @default(uuid())
  reservationId String
  reservation   Reservation       @relation(fields: [reservationId], references: [id])
  treatmentId   String
  treatment     Treatment         @relation(fields: [treatmentId], references: [id])
  therapistName String
  scheduledAt   DateTime
  status        AppointmentStatus @default(BOOKED)
  createdAt     DateTime          @default(now())
}

enum AppointmentStatus {
  BOOKED
  POSTED
  CANCELLED
}

model Account {
  id         String      @id @default(uuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id])
  code       String
  name       String
  type       AccountType
  createdAt  DateTime    @default(now())

  journalLines JournalLine[]

  @@unique([propertyId, code])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id          String   @id @default(uuid())
  propertyId  String
  date        DateTime
  description String
  createdAt   DateTime @default(now())

  lines            JournalLine[]
  folioTransaction FolioTransaction?
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(10, 2)
  credit         Decimal      @default(0) @db.Decimal(10, 2)
}

model Supplier {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  contact    String?
  createdAt  DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
}

model InventoryItem {
  id             String  @id @default(uuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  name           String
  unit           String
  quantityOnHand Decimal @default(0) @db.Decimal(10, 2)
  reorderLevel   Decimal @default(0) @db.Decimal(10, 2)

  purchaseOrderItems PurchaseOrderItem[]
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  propertyId String
  property   Property            @relation(fields: [propertyId], references: [id])
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime            @default(now())

  items           PurchaseOrderItem[]
  supplierInvoice SupplierInvoice?
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(10, 2)
  unitCost        Decimal       @db.Decimal(10, 2)
}

model SupplierInvoice {
  id              String   @id @default(uuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?  @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal  @db.Decimal(10, 2)
  dueDate         DateTime
  status          SupplierInvoiceStatus @default(UNPAID)
  createdAt       DateTime @default(now())
}

enum SupplierInvoiceStatus {
  UNPAID
  PAID
}

model CorporateAccount {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  creditLimit Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoices ArInvoice[]
}

model ArInvoice {
  id                 String           @id @default(uuid())
  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id])
  amount             Decimal          @db.Decimal(10, 2)
  description        String
  dueDate            DateTime
  status             ArInvoiceStatus  @default(UNPAID)
  createdAt          DateTime         @default(now())
}

enum ArInvoiceStatus {
  UNPAID
  PAID
}

model Employee {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  firstName  String
  lastName   String
  department String
  phone      String?
  hireDate   DateTime
  active     Boolean  @default(true)

  shifts             Shift[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  startTime  String
  endTime    String
  department String
}

model EventInquiry {
  id             String             @id @default(uuid())
  propertyId     String
  property       Property           @relation(fields: [propertyId], references: [id])
  contactName    String
  contactEmail   String
  eventDate      DateTime
  expectedGuests Int
  status         EventInquiryStatus @default(INQUIRY)
  createdAt      DateTime           @default(now())

  roomBlock RoomBlock?
  quote     EventQuote?
}

enum EventInquiryStatus {
  INQUIRY
  QUOTED
  CONFIRMED
  CANCELLED
}

model RoomBlock {
  id             String       @id @default(uuid())
  eventInquiryId String       @unique
  eventInquiry   EventInquiry @relation(fields: [eventInquiryId], references: [id])
  startDate      DateTime
  endDate        DateTime
  roomsBlocked   Int
  notes          String?
  createdAt      DateTime     @default(now())
}

model EventQuote {
  id             String       @id @default(uuid())
  eventInquiryId String       @unique
  eventInquiry   EventInquiry @relation(fields: [eventInquiryId], references: [id])
  amount         Decimal      @db.Decimal(10, 2)
  depositAmount  Decimal      @db.Decimal(10, 2)
  depositPaid    Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model HousekeepingTask {
  id           String                 @id @default(uuid())
  roomId       String
  room         Room                   @relation(fields: [roomId], references: [id])
  assignedToId String?
  assignedTo   Employee?              @relation(fields: [assignedToId], references: [id])
  status       HousekeepingTaskStatus @default(PENDING)
  notes        String?
  createdAt    DateTime               @default(now())
  completedAt  DateTime?
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  INSPECTED
}

model MaintenanceTicket {
  id           String              @id @default(uuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id])
  roomId       String?
  room         Room?               @relation(fields: [roomId], references: [id])
  description  String
  priority     MaintenancePriority @default(ROUTINE)
  status       MaintenanceStatus   @default(OPEN)
  assignedToId String?
  assignedTo   Employee?           @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
}

enum MaintenancePriority {
  EMERGENCY
  URGENT
  ROUTINE
  PREVENTIVE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model RatePlan {
  id            String       @id @default(uuid())
  roomTypeId    String
  roomType      RoomType     @relation(fields: [roomTypeId], references: [id])
  name          String
  type          RatePlanType @default(BAR)
  adjustmentPct Decimal      @default(0) @db.Decimal(5, 2)
  minStay       Int?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

enum RatePlanType {
  BAR
  CORPORATE
  PACKAGE
  NON_REFUNDABLE
}

model AuditLog {
  id         String   @id @default(uuid())
  userEmail  String?
  role       String?
  method     String
  path       String
  statusCode Int?
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  type       String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}
